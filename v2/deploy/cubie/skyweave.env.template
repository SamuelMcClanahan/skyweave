# SkyWeave drone stack: board configuration (contract B-D3).
#
# install.sh copies this file to /etc/skyweave/skyweave.env (owner root,
# mode 0600) on the first install. It never overwrites that file later.
# This is the ONE place for every command-line flag of the two services.
#
# File rules (systemd reads this file, not a shell):
#   - One KEY=value on each line. No spaces around "=".
#   - Nothing is expanded: "$VAR" and "$(command)" stay as text.
#   - A value has no spaces, except the two *_CMD lines.
#   - /opt/skyweave/bin/skyweave-run fills each {field} in the two *_CMD
#     lines from the variable that the comment names.
#   - A value that contains CHANGE_ME is a placeholder. The service does
#     not start until you replace it.
#
# After each edit:  sudo /opt/skyweave/bin/skyweave-run check
#                   sudo systemctl restart skyweave-companion skyweave-percepd

# ---------------------------------------------------------------------------
# Ground UI token (contract [P5c]). The operator types the same value in the
# UI page. Use 8 to 256 characters from: letters, digits, "." "_" "-".
# Keep it secret. Do not put it in the repository, a chat or a log.
# It is empty here on purpose. The companion does not start without it.
SKYWEAVE_UI_TOKEN=

# ---------------------------------------------------------------------------
# Flight controller link (contract [F1] part (c), B-D1).
# The UART of the Cubie that connects to FC SERIAL1 (UART7), MAVLink2.
# PLACEHOLDER: the device name on the Cubie A7S is not known. The README
# section "Find the UART" tells you how to find it. Example: /dev/ttyAS1
SKYWEAVE_FC_DEVICE=/dev/CHANGE_ME
# The FC side is set to 921600 baud (E1 brief section 2).
SKYWEAVE_FC_BAUD=921600

# ---------------------------------------------------------------------------
# Ground UI address (contract [U1]).
# PLACEHOLDER: the IPv4 address of the Cubie on its Wi-Fi access point.
# The UI listens on this address only. Fallback: 0.0.0.0 listens on every
# interface (README section "UI address"). 127.0.0.1 is for tests on the
# board only.
SKYWEAVE_UI_HOST=CHANGE_ME
SKYWEAVE_UI_PORT=8080

# ---------------------------------------------------------------------------
# Recordings (contract [R1]). One new file for each companion start.
SKYWEAVE_RECORD_DIR=/var/lib/skyweave/recordings
# Disk safety. Before each companion start, skyweave-run deletes the oldest
# recordings until the directory is smaller than this limit. It always keeps
# the newest one.
SKYWEAVE_RECORD_MAX_MB=2048
# The companion does not start with less free disk space than this.
SKYWEAVE_RECORD_MIN_FREE_MB=512

# ---------------------------------------------------------------------------
# Companion command line. Fields: {fc_device} {fc_baud} {record} {ui_host}
# {ui_port}. {record} is the new recording file that skyweave-run names.
# Bench rule (B-D1): "--enable-setpoints" is not permitted here.
# skyweave-run refuses to start the companion if this line contains it.
SKYWEAVE_COMPANION_CMD=python -m skyweave2.drone.companiond --fc serial:{fc_device}:{fc_baud} --real-fc --record {record} --ui-host {ui_host} --ui-port {ui_port}

# ---------------------------------------------------------------------------
# Camera (contract [C2]). The udev rule 60-skyweave.rules makes this name
# for the AR0234 USB camera. Alternative: a /dev/v4l/by-id/...-video-index0
# path (README section "Camera").
SKYWEAVE_CAMERA=/dev/skyweave-cam
# PLACEHOLDER: the detector model file (B-D2). Copy it to
# /var/lib/skyweave/models/ and write its name here.
SKYWEAVE_MODEL=/var/lib/skyweave/models/CHANGE_ME.onnx
# Where percepd sends detection packets: the companion's detection port
# (contract section 9). Keep it on 127.0.0.1 ([C10]).
SKYWEAVE_DETECTION_DEST=127.0.0.1:14601

# percepd command line. Fields: {camera} {model} {dest}.
# The flag names of percepd are not final (B-D2). When they change, change
# this line only.
SKYWEAVE_PERCEPD_CMD=python -m skyweave2.drone.percepd --camera {camera} --width 1920 --height 1200 --pixel-format YUYV --model {model} --dest {dest}
